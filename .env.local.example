# Copy to .env.local (git-ignored) for local dev, and set the same keys in Vercel's
# Project Settings → Environment Variables for deployment.

# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Project Settings → API → service_role (secret!) — server-only, no NEXT_PUBLIC_ prefix.
# Used by Route Handlers for privileged writes (import, assignment, verification, config, exports).
SUPABASE_SERVICE_ROLE_KEY=

# §20.1 weekly Google Sheets export — a Google Cloud service account with Sheets + Drive API
# access, scoped to the target Drive folder. Paste the service account JSON key as a single line.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Shared secret Vercel Cron sends so the export/purge routes can't be triggered by anyone else.
CRON_SECRET=
